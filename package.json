{
  "name": "my-movies-cli",
  "version": "1.0.0",
  "description": "A CLI tool for Letterboxd movie recommendations and watchlist management.",
  "main": "dist/index.js",
  "bin": {
    "my-movies-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "chroma:start": "npx chroma run --path ./data/chroma_db",
    "start": "npm run chroma:start & wait-on http://localhost:8000/api/v1/heartbeat && ts-node src/index.ts",
    "dev": "npm run chroma:start & wait-on http://localhost:8000/api/v1/heartbeat && NODE_TLS_REJECT_UNAUTHORIZED='0' ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "npx @biomejs/biome format --write ./src",
    "lint": "npx @biomejs/biome lint ./src",
    "check": "npx @biomejs/biome check ./src",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cheerio": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.10.0",
    "cheerio": "^1.1.1",
    "chromadb": "^3.1.7",
    "cli-spinners": "^2.9.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "inquirer": "^9.2.20",
    "knex": "^3.1.0",
    "puppeteer": "^24.14.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^9.0.4",
    "@types/node": "^24.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/inquirer": "^9.0.8"
  }
}